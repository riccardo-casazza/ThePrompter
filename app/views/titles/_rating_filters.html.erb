<div class="filter-group">
  <%= label_tag :min_rating, "Min IMDB Rating" %>
  <%= number_field_tag :min_rating, @min_rating,
      min: 0,
      max: 10,
      step: 0.1,
      placeholder: "e.g. 7.0" %>
</div>

<div class="filter-group">
  <%= label_tag :max_rating, "Max IMDB Rating" %>
  <%= number_field_tag :max_rating, @max_rating,
      min: 0,
      max: 10,
      step: 0.1,
      placeholder: "e.g. 7.0" %>
</div>

<div class="filter-group">
  <%= label_tag :min_votes, "Min Votes" %>
  <%= number_field_tag :min_votes, @min_votes,
      min: 0,
      placeholder: "e.g. 10000" %>
</div>
