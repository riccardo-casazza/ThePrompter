<h1>Awards</h1>

<div class="filters">
  <%= form_with url: awards_path, method: :get, local: true do %>
    <%= render "year_filters", required: false %>
    <%= render "rating_filters" %>
    <%= render "show_filters" %>
    <%= render "language_filters" %>

    <button type="submit">Search</button>
  <% end %>
</div>

<% if @error.present? %>
  <div class="error"><%= @error %></div>
<% elsif @titles.any? %>
  <p class="results-count">
    Showing <%= @titles.size %> award-winning titles
    <% if @titles.size == 500 %>(limited to 500 results)<% end %>
  </p>

  <%= render "results_table", show_awards: true, awards_by_tconst: @awards_by_tconst %>
<% else %>
  <div class="info">
    <% if @start_year.nil? %>
      All award-winning movies will be shown. Use filters to narrow down results.
    <% else %>
      No award-winning titles found for the selected criteria.
    <% end %>
  </div>
<% end %>
