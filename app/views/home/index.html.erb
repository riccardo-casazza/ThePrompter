<h1>ThePrompter</h1>

<nav>
  <ul>
    <li><%= link_to "Browse Titles", titles_path %></li>
    <li><%= link_to "Plex Delete Candidates", titles_path(
      title_type: "movie",
      max_rating: 6.5,
      min_votes: 10000,
      max_my_rating: 6.5,
      show_in_plex: "only",
      show_already_watched: "yes",
      show_with_preferences: "no",
      show_in_collection: "no",
      show_documentaries: "no",
      sort_by: "average_rating",
      sort_direction: "asc"
    ) %></li>
  </ul>
</nav>

<% if @job_statuses.any? %>
  <section class="job-statuses">
    <h2>Background Jobs Status</h2>
    <table>
      <thead>
        <tr>
          <th>Job</th>
          <th>Last Run</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% @job_statuses.each do |job| %>
          <tr>
            <td><%= job[:name].titleize %></td>
            <td>
              <% if job[:last_run] %>
                <%= time_tag job[:last_run], time_ago_in_words(job[:last_run]) + " ago" %>
              <% else %>
                Never
              <% end %>
            </td>
            <td class="status-<%= job[:status] %>">
              <%= job[:status]&.titleize || "Unknown" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>
